<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <ImageView
        android:id="@+id/ivCategoria"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <TextView
        android:id="@+id/tvNombreCategoria"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Nombre categoría"
        android:textStyle="bold"
        android:textSize="16sp"
        app:layout_constraintStart_toEndOf="@id/ivCategoria"
        app:layout_constraintTop_toTopOf="@id/ivCategoria"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tvDescripcionCategoria"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Descripción breve"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="@id/tvNombreCategoria"
        app:layout_constraintTop_toBottomOf="@id/tvNombreCategoria"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>